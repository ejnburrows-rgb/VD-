import express from 'express';
import { exec } from 'child_process';
import { promisify } from 'util';
import { readFileSync, unlinkSync, existsSync } from 'fs';
import { tmpdir } from 'os';
import { join } from 'path';
import ytDlp from 'youtube-dl-exec';
import Groq from 'groq-sdk';
import cors from 'cors';

const execAsync = promisify(exec);
const app = express();
const groq = new Groq({ apiKey: process.env.GROQ_API_KEY });

app.use(cors());
app.use(express.json());

app.get('/health', (req, res) => {
  res.json({ status: 'ok', service: 'Viajera Transcription API' });
});

app.post('/api/transcribe', async (req, res) => {
  const tempFiles = [];
  const startTime = Date.now();

  try {
    const { youtube_url } = req.body;

    if (!youtube_url?.includes('youtube') && !youtube_url?.includes('youtu.be')) {
      return res.status(400).json({ success: false, error: 'URL inválida' });
    }

    console.log(' Descargando:', youtube_url);

    const audioPath = join(tmpdir(), udio_.mp3);
    tempFiles.push(audioPath);

    await ytDlp(youtube_url, {
      extractAudio: true,
      audioFormat: 'mp3',
      audioQuality: 128,
      output: audioPath,
    });

    console.log(' Audio descargado');

    const { stdout } = await execAsync(
      fprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 ""
    );
    const duration = parseFloat(stdout);
    console.log( Duración:  minutos);

    let chunks = [audioPath];
    if (duration > 1200) {
      console.log(' Dividiendo audio...');
      const pattern = join(tmpdir(), chunk__%03d.mp3);
      await execAsync(
        fmpeg -i "" -f segment -segment_time 1200 -c copy ""
      );
      chunks = [];
      for (let i = 0; i < Math.ceil(duration / 1200); i++) {
        const chunk = pattern.replace('%03d', String(i).padStart(3, '0'));
        if (existsSync(chunk)) {
          chunks.push(chunk);
          tempFiles.push(chunk);
        }
      }
      console.log(  chunks creados);
    }

    console.log(' Transcribiendo...');
    const transcripts = [];
    for (let i = 0; i < chunks.length; i++) {
      const buffer = readFileSync(chunks[i]);
      const file = new File([buffer], 'audio.mp3', { type: 'audio/mpeg' });
      const result = await groq.audio.transcriptions.create({
        file,
        model: 'whisper-large-v3',
        language: 'es',
      });
      transcripts.push(result);
      console.log( Chunk /);
    }
    const fullText = transcripts.join(' ');
    console.log( Transcripción:  caracteres);

    console.log(' Formateando décimas...');
    const formatted = await groq.chat.completions.create({
      model: 'llama-3.1-70b-versatile',
      messages: [{
        role: 'user',
        content: Identifica décimas espinelas. JSON: {"decimas":[]}.\n\nTexto:
      }],
      temperature: 0.2,
    });

    let decimas = [];
    try {
      const json = formatted.choices[0].message.content.replace(/`json|`/g, '');
      decimas = JSON.parse(json).decimas || [];
    } catch (e) {
      console.log(' No se formatearon décimas');
    }

    tempFiles.forEach(f => { try { unlinkSync(f); } catch (e) {} });

    const elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
    res.json({
      success: true,
      transcript: fullText,
      decimas,
      stats: {
        chunks: chunks.length,
        duracion_minutos: Math.round(duration / 60),
        tiempo_segundos: parseFloat(elapsed),
      },
    });

  } catch (error) {
    tempFiles.forEach(f => { try { unlinkSync(f); } catch (e) {} });
    res.status(500).json({ success: false, error: error.message });
  }
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
  console.log( Server en http://localhost:);
  console.log( GET  http://localhost:/health);
  console.log( POST http://localhost:/api/transcribe);
});
